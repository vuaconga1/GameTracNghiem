# =============================================================================
# Hai file env chạy song song
# =============================================================================
# .env          → Neon (cloud)
# .env.local    → PostgreSQL local — ghi đè khi npm run dev:local
#
# npm run dev              → Neon (.env)
# npm run dev:local        → Postgres local (.env.local)
# npm run db:deploy        → migrate Neon
# npm run db:deploy:local  → migrate local
# =============================================================================

# --- Neon (cloud) — file .env ---
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Local Postgres — file .env.local ---
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/wewin_game"
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/wewin_game"

SESSION_SECRET="replace-with-long-random-string-at-least-32-chars"

# Parent Portal SSO (must match Apps Script CFG.GAME_SSO_SECRET)
PORTAL_SSO_SECRET="replace-with-shared-portal-sso-secret-32+"

# Groq Whisper (pronunciation game). Missing/429 → client falls back to Web Speech.
# https://console.groq.com/keys
GROQ_API_KEY=""

# OpenAI Realtime (AI Speaking). Key stays server-side only.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime-mini"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
OPENAI_GUIDED_MODEL="gpt-4o-mini"
# Emergency student kill switch. Admin prompt preview remains available and is
# visibly marked as bypassing this student-access switch.
SPEAKING_EMERGENCY_DISABLED="false"

# Durable Realtime hard stop. Production must use qstash and fails closed when
# any required value is missing. Local/test may explicitly set "local".
SPEAKING_SESSION_END_SCHEDULER="qstash"
SPEAKING_PUBLIC_BASE_URL="https://your-production-domain.example"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="replace-with-long-random-cron-secret"
# Optional HMAC secret for non-QStash internal Speaking callbacks.
SPEAKING_INTERNAL_CALLBACK_SECRET="replace-with-another-long-random-secret"

# One-release rollback only: allows ?legacyRealtime=1 for ADMIN_PREVIEW.
# Student sessions always use backend unified WebRTC SDP exchange.
SPEAKING_REALTIME_LEGACY_CLIENT_SECRET_FALLBACK="false"

# Local-only explicit fallback example (never accepted in production):
# SPEAKING_SESSION_END_SCHEDULER="local"

# Google Drive — Speaking recordings (service account)
# Folder: https://drive.google.com/drive/folders/1_r_lSba4dHyngN0boNm70kKEWxTaKa7G
GOOGLE_DRIVE_SPEAKING_FOLDER_ID="1_r_lSba4dHyngN0boNm70kKEWxTaKa7G"
# Paste the full service-account JSON as a single line (escape newlines as \n in private_key).
# Share that folder with the service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Optional alternative for Vercel: base64 of the JSON file
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""
# Realtime recordings stay private and are deleted from Blob/local + Drive
# after 30 days by the CRON_SECRET-protected speaking-recordings cron.

# Vercel Blob (bắt buộc trên Vercel để lưu/đọc PDF ebook — disk local không tồn tại trên serverless)
# Tạo tại: Vercel → Project → Storage → Blob → tạo store → copy token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ElevenLabs batch IPA audio (scripts/generate-elevenlabs-ipa-audio.ts)
# Key: https://elevenlabs.io/app/settings/api-keys
# Voice ID: chạy `npx tsx scripts/generate-elevenlabs-ipa-audio.ts --list-voices`
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_VOICE_NAME="Alice"
# ELEVENLABS_AUDIO_OUT="E:/Wewin/Game Trắc Nghiệm/audio/elevenlabs-ipa"

# Renamed flat vocab mp3 (ElevenLabs → public/audio/vocab)
# Sync: npm run audio:vocab:sync
# Audit DB coverage: npm run audio:vocab:audit:local | audio:vocab:audit:neon
# Optional legacy hierarchical pack for local /api/wewin-audio:
# WEWIN_AUDIO_ROOT="E:/Wewin/WeWinGame/Wewin-Education-main/audio_wewin"
