{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/speaking-session-ends",
      "schedule": "12 3 * * *"
    },
    {
      "path": "/api/cron/speaking-recordings",
      "schedule": "17 2 * * *"
    },
    {
      "path": "/api/cron/guest-access-report",
      "schedule": "0 2 * * 2"
    }
  ]
}
